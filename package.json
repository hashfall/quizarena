    "cron": "tsx server/scripts/cron.ts",
    "reset:dia": "tsx scripts/reset-dia.ts",
    "teste:texto": "tsx scripts/testar-texto.ts",
    "teste:e2e": "tsx scripts/testar-e2e.ts",
    "inspecionar": "tsx scripts/inspecionar-disciplina.ts",
